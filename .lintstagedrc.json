{
  "*.{ts,tsx}": [
    "node ./scripts/tailwind-canonical.ts --write",
    "oxfmt --write --no-error-on-unmatched-pattern",
    "oxlint --fix --deny-warnings"
  ],
  "*.{js,jsx,mjs,cjs}": [
    "oxfmt --write --no-error-on-unmatched-pattern",
    "oxlint --fix --deny-warnings"
  ],
  "*.{json,css,md,mdx,yaml,yml}": "oxfmt --write --no-error-on-unmatched-pattern"
}
