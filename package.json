{
  "name": "mantle",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:agent-docs": "node ./scripts/check-agent-docs.ts",
    "check:changed": "node ./scripts/check-changed.ts",
    "check:doc-links": "node ./scripts/check-doc-links.ts",
    "start": "turbo run start",
    "serve": "turbo run serve",
    "clean": "turbo run clean",
    "clean:node_modules": "node ./scripts/clean-node-modules.js",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt --write",
    "lint:fix": "oxlint --type-aware --ignore-pattern=.claude/worktrees --fix",
    "lint": "oxlint --type-aware --deny-warnings --ignore-pattern=.claude/worktrees",
    "install:playwright": "node ./scripts/install-playwright.js",
    "kill:dev-servers": "node ./scripts/kill-dev-servers.ts",
    "test": "turbo run test",
    "test:scripts": "vitest run --config ./scripts/vitest.config.ts",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsrs -p scripts/tsconfig.json",
    "tailwind:check": "node ./scripts/tailwind-canonical.ts",
    "tailwind:fix": "node ./scripts/tailwind-canonical.ts --write",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "turbo run build --filter=@ngrok/mantle --filter=@ngrok/mantle-vite-plugins --filter=@ngrok/mantle-server-syntax-highlighter && changeset publish",
    "migrate": "node ./scripts/migrate.ts"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@tailwindcss/node": "catalog:",
    "@tailwindcss/oxide": "catalog:",
    "@types/node": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxc-parser": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
