{
  "name": "mantle",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:agent-docs": "node ./scripts/check-agent-docs.ts",
    "report:bundle-size": "pnpm -F @ngrok/mantle run report:bundle-size",
    "check:changed": "node ./scripts/check-changed.ts",
    "check:css-selectors": "node ./scripts/check-css-selectors.ts",
    "check:data-attributes": "node ./scripts/check-data-attributes.ts",
    "check:dist": "pnpm -F @ngrok/mantle run check:dist",
    "check:doc-links": "node ./scripts/check-doc-links.ts",
    "check:prose": "node ./scripts/check-prose.ts",
    "start": "turbo run start",
    "serve": "turbo run serve",
    "clean": "turbo run clean",
    "clean:node_modules": "node ./scripts/clean-node-modules.js",
    "eval:agents": "node ./scripts/agent-eval/run.ts",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt --write",
    "lint:fix": "oxlint --type-aware --ignore-pattern=.claude/worktrees --fix",
    "lint": "oxlint --type-aware --deny-warnings --ignore-pattern=.claude/worktrees",
    "install:playwright": "node ./scripts/install-playwright.js",
    "kill:dev-servers": "node ./scripts/kill-dev-servers.ts",
    "test": "turbo run test",
    "test:scripts": "vitest run --config ./scripts/vitest.config.ts",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsrs -p scripts/tsconfig.json",
    "tailwind:check": "node ./scripts/tailwind-canonical.ts",
    "tailwind:fix": "node ./scripts/tailwind-canonical.ts --write",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version && node ./scripts/stamp-migrations.ts",
    "changeset:publish": "turbo run build --filter=@ngrok/mantle --filter=@ngrok/mantle-vite-plugins --filter=@ngrok/mantle-server-syntax-highlighter --filter=@ngrok/oxlint-plugin && changeset publish",
    "migrate": "node ./scripts/migrate.ts"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@tailwindcss/node": "catalog:",
    "@tailwindcss/oxide": "catalog:",
    "@types/node": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "oxc-parser": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "7.0.2008",
    "tsrs": "7.1.0-beta.tsrs5",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@12.23.0"
}
