{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "jsdoc",
    "jsx-a11y",
    "promise",
    "react-perf",
    "react",
    "typescript",
    "unicorn",
    "vitest"
  ],
  // Why a local plugin: these conventions have no built-in rule. See scripts/oxlint-plugin-mantle.js.
  "jsPlugins": ["./scripts/oxlint-plugin-mantle.js"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "array-callback-return": "error",
    "control-has-associated-label": "off",
    "curly": "error",
    "eslint/no-nested-ternary": "error",
    "eqeqeq": ["error", "always", { "null": "never" }],
    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "jsdoc/check-property-names": "error",
    "mantle/no-jsx-null-ternary": "error",
    "jsx-a11y/anchor-has-content": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsdoc/check-tag-names": [
      "error",
      {
        "definedTags": [
          "defaultValue",
          "docs",
          "note",
          "preview",
          "remarks",
          "required",
          "siblings",
          "typeParam",
          "useWhen",
          "warning"
        ]
      }
    ],
    "jsdoc/empty-tags": "off",
    "jsdoc/no-defaults": "error",
    "jsdoc/require-param-name": "error",
    "jsdoc/require-property-description": "error",
    "jsdoc/require-property-name": "error",
    "jsdoc/require-property-type": "off",
    "jsdoc/require-property": "off",
    "jsdoc/require-throws-description": "error",
    "jsdoc/require-yields": "off",
    "no-explicit-any": "error",
    "no-fallthrough": "error",
    // Why skipComments: zero-width spaces in JSDoc keep literal `*/` examples
    // from closing the comment block (parse-theme-css.ts, compute-css-fold-ranges.ts).
    "no-irregular-whitespace": ["error", { "skipComments": true }],
    "no-promise-executor-return": "error",
    "no-prototype-builtins": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "location",
        "message": "Read the location from a prop or an argument. In apps/www, use the router's location hook (docs/framework-boundary.md)."
      }
    ],
    "no-shadow": "off",
    "no-throw-literal": "error",
    "no-useless-switch-case": "off",
    "no-var": "error",
    "prefer-const": "error",
    "promise/always-return": "error",
    "promise/no-return-wrap": "error",
    "react/button-has-type": "error",
    "react/checked-requires-onchange-or-readonly": "error",
    "react/display-name": "error",
    "react/exhaustive-deps": "error",
    // Every rule that ports a React Compiler diagnostic. The compiler passes
    // use the same checks (packages/mantle/react-compiler.config.ts), so lint
    // reports in the editor what the build would reject.
    "react/capitalized-calls": "error",
    "react/error-boundaries": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/globals": "error",
    "react/hooks": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/invariant": "error",
    "react/memo-dependencies": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/rule-suppression": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/syntax": "error",
    "react/todo": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    "react/iframe-missing-sandbox": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/jsx-no-script-url": "error",
    "react/jsx-no-target-blank": ["error", { "allowReferrer": true }],
    "react/jsx-no-useless-fragment": "error",
    "react/no-array-index-key": "error",
    "react/no-danger": "off",
    "react/no-object-type-as-default-prop": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "error",
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/self-closing-comp": "error",
    // Why off: the `noImplicitReturns` compiler option already fails a path
    // that falls off the end of a function that returns a value. This rule
    // also flags the bare `return;` in an effect and a function that ends in
    // an exhaustive `switch`, and its fix hides a new union member from the
    // compiler.
    "typescript/consistent-return": "off",
    "typescript/consistent-type-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase", "ignore": ["[\\[\\$]"] }]
  },
  "overrides": [
    {
      // Why: `@ngrok/mantle` depends on React alone. A router or app framework in
      // its source becomes a peer every consumer installs, pinned to that
      // framework's major (the `AutoScrollToHash` lesson). The glue that reads
      // router state lives in the app, as a recipe under `apps/www`.
      // See docs/framework-boundary.md.
      "files": ["packages/mantle/src/**"],
      "rules": {
        "mantle/no-default-export": "error",
        "mantle/no-display-name": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["forwardRef", "FC", "FunctionComponent"],
                "message": "React 19 passes `ref` as a regular prop, and a component takes an inline function type (CONVENTIONS.md § Readability & Maintainability)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "react-router",
                  "react-router/*",
                  "react-router-dom",
                  "@remix-run/*",
                  "@tanstack/react-router",
                  "@tanstack/react-router/*",
                  "next",
                  "next/*"
                ],
                "message": "@ngrok/mantle depends on React alone. Type the seam structurally and put the router glue in an apps/www recipe (docs/framework-boundary.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.browser.test.{ts,tsx}"],
      "rules": {
        "react/no-object-type-as-default-prop": "off",
        // Why: the compiler pass skips test files, so a test component can count its renders in a module value.
        "react/immutability": "off",
        "unicorn/consistent-function-scoping": "off",
        // Why: docs/testing.md has tests evaluate an inline <script> string with `new Function`.
        "typescript/no-implied-eval": "off",
        // Why: test fixtures still cast to build partial objects; moving them to `satisfies` is its own sweep.
        "typescript/no-unsafe-type-assertion": "off",
        "mantle/no-absent-class-assertion": "error",
        "mantle/no-bare-to-have-been-called": "error",
        "mantle/no-presence-matcher-on-get-by": "error",
        "mantle/no-sleep-in-tests": "error",
        "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expect*"] }]
      }
    }
  ],
  "ignorePatterns": [
    ".cache",
    ".changeset",
    ".env",
    ".react-router/",
    ".turbo",
    ".vercel",
    "build",
    "dist",
    "node_modules",
    "public",
    "*/code-gen",
    "packages/mantle/src/utils/cx/vendor"
  ]
}
