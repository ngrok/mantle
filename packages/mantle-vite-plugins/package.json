{
  "name": "@ngrok/mantle-vite-plugins",
  "version": "1.2.2",
  "description": "Vite plugins for @ngrok/mantle.",
  "homepage": "https://mantle.ngrok.com",
  "license": "MIT",
  "author": "ngrok",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngrok/mantle"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@ngrok/src-live-types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/clean-publish-manifest.js clean",
    "postpack": "node ../../scripts/clean-publish-manifest.js restore",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ngrok/mantle-server-syntax-highlighter": "workspace:*",
    "magic-string": "1.4.1",
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@cfg/tsconfig": "workspace:*",
    "@ngrok/mantle": "workspace:*",
    "@tailwindcss/oxide": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@ngrok/mantle": "*",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.0.0"
  }
}
