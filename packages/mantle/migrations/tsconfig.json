{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@cfg/tsconfig/tsconfig.client-package.json",
  // Why: the fixtures model consumer code on the old and the new API, so no typecheck runs on them.
  // This file gives type-aware lint an owner for each fixture.
  "include": ["**/*.ts", "**/*.tsx"]
}
