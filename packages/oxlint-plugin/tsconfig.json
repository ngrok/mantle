{
  "extends": "@cfg/tsconfig/tsconfig.client-package.json",
  "compilerOptions": {
    "lib": ["ES2025"],
    "types": ["node"],
    // Why `.ts` specifiers: oxlint loads this plugin from source, and Node's type stripping resolves
    // the specifier as written. CI lints right after install with no build, so a `dist` import would
    // break `pnpm lint`. tsdown rewrites the extensions when it bundles.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*", "*.config.ts"]
}
