{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxAge": "7d",
  "agentGuidance": false,
  "globalEnv": ["VERCEL_GIT_COMMIT_SHA", "VERCEL_DEPLOYMENT_ID", "VERCEL"],
  "globalPassThroughEnv": ["CI", "DISABLE_HEADLESS", "PLAYWRIGHT_WS_ENDPOINT"],
  "tasks": {
    "build": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.test.*"],
      "dependsOn": ["^build"],
      "outputs": ["**/build/**", "**/.vercel/**", "**/dist/**", "!**/node_modules/**"]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "serve": {
      "dependsOn": ["^build"],
      "outputs": ["public/build/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "//#install:playwright": {
      "cache": false
    },
    "//#test:scripts": {
      "inputs": [
        "scripts/**",
        "packages/mantle/migrations/**",
        "apps/www/app/docs/migrations/**",
        ".changeset/*.md"
      ]
    },
    "test": {
      "dependsOn": ["^build", "//#install:playwright", "//#test:scripts"]
    },
    "@ngrok/mantle#test": {
      "dependsOn": ["^build", "//#install:playwright", "//#test:scripts"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/www/app/docs/**",
        "$TURBO_ROOT$/apps/www/app/utilities/__snapshots__/components-surface.json"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "//#typecheck:scripts"],
      "cache": false,
      "outputs": ["**/.react-router/**"]
    },
    "//#typecheck:scripts": {
      "inputs": ["scripts/**", ".claude/hooks/**"]
    }
  },
  "remoteCache": {
    "enabled": true,
    "apiUrl": "https://turborepo.corp.ngrok.com"
  }
}
